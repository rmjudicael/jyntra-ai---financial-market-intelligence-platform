# JYNTRA structured-risk adapter — training configuration (template)
#
# Target: Muse Glimmer 30B (Apache 2.0) with LoRA on top of a 4-bit base.
# This file documents the intended run. It has NOT been executed on this
# machine: no GPU, 15.9 GB RAM, no C++ toolchain. See docs/fine-tuning.md.
#
# Runtime: llama.cpp `llama-finetune` (CPU/CUDA), no Hugging Face dependency.

BASE_MODEL=Muse-Glimmer-30B-Q4_K_M.gguf
BASE_MODEL_SOURCE=https://www.modelscope.cn/models/bartowski/Muse-Glimmer-30B-GGUF
TRAIN_FILE=finetune/data/train.txt
VALIDATION_FILE=finetune/data/validation.txt
SAMPLE_START=<|sft|>
OUTPUT_ADAPTER=finetune/adapters/jyntra-risk-muse-glimmer-30b-lora-v1.bin
ADAPTER_ID=jyntra-risk-muse-glimmer-30b-lora-v1

# LoRA / optimisation
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LEARNING_RATE=0.0002
EPOCHS=2
ADAM_ITER=240
CONTEXT_LENGTH=512
BATCH_SIZE=1
MICRO_BATCH_SIZE=1
THREADS=8
SAVE_EVERY=60

# Hardware envelope for the intended run:
#   GPU: >= 24 GB VRAM for 4-bit 30B LoRA (RTX 4090 / A6000 class)
#   RAM: >= 32 GB
#   Disk: >= 25 GB free
# Measured local machine: 15.9 GB RAM, 20.7 GB free, no GPU -> blocked.
