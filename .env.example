# Copiez ce fichier vers ".env" (jamais commite) et renseignez vos cles cote serveur uniquement.
# Fournisseur principal Meta (prioritaire) : cle + endpoint de base officiel.
META_API_KEY=
META_API_ENDPOINT=https://api.meta.ai/v1
# Identifiants declares, envoyes verbatim au fournisseur (il decide de leur disponibilite reelle).
META_MODELS=muse-wonder-1.0,sam-3.1,muse-spark-1.3-contributor,muse-spark-1.3,muse-voice-transcribe-1.0,muse-image-1.0,muse-spark-1.2-contributor,muse-spark-1.2,muse-spark-1.1
PORT=3000
