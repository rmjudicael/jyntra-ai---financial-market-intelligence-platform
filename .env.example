# JYNTRA AI — environment template.
# Copy this file to ".env" (never commit) and fill in keys server-side only.
# Every integration degrades honestly when its key is absent: no fake success.

# ---------------------------------------------------------------------------
# 1. Meta Model API (primary tier)
# ---------------------------------------------------------------------------
META_API_KEY=
# Base URL or full chat-completions URL.
META_API_ENDPOINT=https://api.meta.ai/v1
# Declared identifiers, sent verbatim to the provider (it decides availability).
META_MODELS=muse-wonder-1.0,sam-3.1,muse-spark-1.3-contributor,muse-spark-1.3,muse-voice-transcribe-1.0,muse-image-1.0,muse-spark-1.2-contributor,muse-spark-1.2,muse-spark-1.1

# ---------------------------------------------------------------------------
# 2. Meta open-weight inference (optional, independent cross-check)
#    Muse Spark Open / Muse Glimmer through an official inference partner.
#    Provider: together | fireworks | baseten | local | openai-compatible
#    The engine refuses any non-Meta checkpoint unless explicitly allowed.
# ---------------------------------------------------------------------------
MUSE_OPEN_WEIGHT_PROVIDER=
MUSE_OPEN_WEIGHT_MODEL_ID=meta-models/muse-spark-open-1026
MUSE_OPEN_WEIGHT_API_KEY=
# Optional: overrides the provider default endpoint.
# together  -> https://api.together.xyz/v1
# fireworks -> https://api.fireworks.ai/inference/v1
# baseten   -> https://inference.baseten.co/v1
# local     -> http://127.0.0.1:8000/v1
MUSE_OPEN_WEIGHT_ENDPOINT=
MUSE_OPEN_WEIGHT_TIMEOUT_MS=60000
# Safety valve only. Leave empty/false for the Meta-only compliance rule.
MUSE_OPEN_WEIGHT_ALLOW_NON_META=false

# Partner-specific key aliases (either form works).
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# ---------------------------------------------------------------------------
# 3. Secondary / tertiary tiers (optional). Absent = tier skipped.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

GROQ_API_KEY=
# FREE_AI_API_KEY is accepted as an alias of GROQ_API_KEY.
FREE_AI_BASE=https://api.groq.com/openai/v1
FREE_AI_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# 4. Runtime
# ---------------------------------------------------------------------------
PORT=3000
MUSE_IMAGE_SIZE=1024x1024

# Security / reverse-proxy awareness.
# TRUST_PROXY=true only when a controlled proxy (Render, nginx) sets
# X-Forwarded-For; otherwise clients could spoof their rate-limit identity.
TRUST_PROXY=false
# Hard cap on tracked rate-limit clients (expired buckets are evicted).
RATE_LIMIT_MAX_ENTRIES=10000

# Provider retry policy: transient failures only (429/5xx/network).
# 1 disables retries; values above 5 are clamped.
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_MS=250
AI_RETRY_MAX_DELAY_MS=4000

# ---------------------------------------------------------------------------
# 5. Local fine-tuned adapter (LoRA/QLoRA), optional.
# Served by an OpenAI-compatible runtime (llama-server --lora, vLLM).
# Leave empty to disable: JYNTRA then reports FINETUNED_NOT_CONFIGURED and
# never pretends an adapter is active.
# ---------------------------------------------------------------------------
JYNTRA_FINETUNED_BASE_URL=
JYNTRA_FINETUNED_MODEL_ID=
JYNTRA_FINETUNED_ADAPTER_ID=
JYNTRA_FINETUNED_BASE_MODEL=
JYNTRA_FINETUNED_API_KEY=
JYNTRA_FINETUNED_TIMEOUT_MS=20000
