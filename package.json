{
  "name": "jyntra-ai",
  "private": true,
  "version": "1.0.0",
  "description": "JYNTRA AI — Financial Market Intelligence Platform (React + Vite + Express)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts --production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
